_worker.js
wrangler.toml
.assetsignore

# ══ [v9.71] .git 이 통째로 공개되던 문제 ═══════════════════════════════════
#  wrangler.toml 의 [assets] directory = "./" 는 프로젝트 폴더 전체를
#  '공개 정적 파일'로 올린다. 여기에 적지 않으면 .git 폴더까지 함께 올라가
#  누구나 https://<주소>/.git/... 로 소스와 커밋 기록을 내려받을 수 있다.
#  (배포 로그에 + /.git/objects/... 가 찍히던 것이 그 증거다)
.git
.git/**
.gitignore
.gitattributes
.github
.github/**

#  wrangler 작업 폴더 — 로컬 상태·캐시
.wrangler
.wrangler/**

#  개발 부산물·비밀정보
node_modules
node_modules/**
package.json
package-lock.json
*.zip
*.log
push-lib.js
.env
.env.*
.dev.vars
.DS_Store
.vscode
.vscode/**
.devcontainer
.devcontainer/**

#  모바일 QA 도구 — 배포 전 검사용이지 공개 자산이 아니다
mobile-qa-check.mjs
mobile-qa-README.md

# PWA manifest is generated by _worker.js so its version always matches the running build
manifest.webmanifest

pwa-install-check.mjs

# ETF data regression tests — deployment QA tool, not a public asset
etf-data-check.mjs

# Technical pattern regression tests — offline QA tool, not a public asset
chart-pattern-check.mjs

# 회귀 검증 도구(지정가 체결가·주문 창구) — 배포 자산이 아니다
tests
tests/**

# 종목명·모바일 헤더/메뉴 회귀 검사 — 배포 자산이 아니다
name-mobile-check.mjs

# [v17.8.47] QA·계측 스크립트가 개별 목록에서 빠져 공개되던 것 — 확장자로 한 번에 막는다
*.mjs
