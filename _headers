# Cloudflare Workers 정적 자산 헤더 규칙
# [v4.22] 매니페스트 주소는 /manifest.webmanifest 로 영구 고정한다.
# (이름·위치·쿼리를 바꾸면 Chrome 이 PWA 업데이트 판정을 못 한다 — 공식 경고)
# 변경 감지는 매니페스트 '안의' 아이콘 파일명(icon-...-307.png)으로만 한다.

# 매니페스트는 항상 최신을 받아야 Chrome 이 아이콘 변경을 인지한다
/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

# 아이콘은 파일명에 버전이 박혀 있어 영구 캐시해도 안전하다
/icon-192-*.png
  Cache-Control: public, max-age=31536000, immutable
/icon-512-*.png
  Cache-Control: public, max-age=31536000, immutable
/icon-maskable-512-*.png
  Cache-Control: public, max-age=31536000, immutable
/favicon.png
  Cache-Control: public, max-age=0, must-revalidate

# HTML 은 항상 최신
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
